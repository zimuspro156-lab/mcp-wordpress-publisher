{
  "name": "mcp-wordpress-publisher",
  "version": "1.2.0",
  "description": "MCP server for publishing and managing WordPress articles via the WordPress REST API.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "wp-json",
    "rest-api",
    "publish",
    "cms",
    "ai",
    "llm"
  ],
  "homepage": "https://github.com/zimuspro156-lab/mcp-wordpress-publisher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zimuspro156-lab/mcp-wordpress-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/zimuspro156-lab/mcp-wordpress-publisher/issues"
  },
  "bin": {
    "mcp-wordpress-publisher": "dist/index.js",
    "mcp-yandex-wordstat": "dist/wordstatServer.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "dev": "tsx src/index.ts",
    "dev:wordstat": "tsx src/wordstatServer.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
