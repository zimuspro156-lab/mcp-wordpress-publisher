# ==========================================================================
#  MCP WordPress Publisher — переменные окружения
#  Скопируйте этот файл в .env и заполните реальными значениями:
#      cp .env.example .env
# ==========================================================================

# Базовый URL сайта WordPress (БЕЗ /wp-json на конце).
WORDPRESS_URL=Url вашего сайта

# Имя пользователя WordPress.
WORDPRESS_USERNAME=имя пользователя

# Пароль приложения (Application Password), а НЕ обычный пароль от админки.
# Создаётся в WP: Пользователи -> Профиль -> Application Passwords.
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ------------------------- Yandex Wordstat (Search API v2) ----------------
# API-ключ из AI Studio / Yandex Cloud. Только сам ключ, БЕЗ префикса "Api-Key ".
# (В n8n префикс пишут в заголовке Authorization; здесь его добавляет сервер.)
# Документация: https://aistudio.yandex.ru/ru/docs/search-api/concepts/wordstat
# YANDEX_API_KEY=AQVN...
#
# ID каталога Yandex Cloud (folderId) — обязателен в теле каждого запроса.
# Смотрите в консоли: https://console.yandex.cloud/ → каталог, или в URL.
# YANDEX_FOLDER_ID=b1g...

# ------------------------- Логирование ------------------------------------
# Уровень логов: error | warn | info | debug  (по умолчанию info)
LOG_LEVEL=info

# Путь к файлу логов. Если не задан — логи пишутся только в stderr.
# LOG_FILE=./logs/mcp-wordpress.log

# ------------------------- Транспорт --------------------------------------
# stdio (по умолчанию) — для Cursor / Claude Desktop (локальный запуск).
# http — Streamable HTTP для ChatGPT и удалённого доступа (URL заканчивается на /mcp).
# MCP_TRANSPORT=http

# Порт и хост HTTP-сервера (только при MCP_TRANSPORT=http).
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=0.0.0.0

# Bearer-токен для авторизации HTTP-запросов (ОБЯЗАТЕЛЕН для публичного доступа!).
# В ChatGPT укажите его как Token. Сгенерируйте длинную случайную строку.
# MCP_AUTH_TOKEN=замените-на-длинный-случайный-токен
